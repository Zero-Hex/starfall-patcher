<Project Sdk="Microsoft.NET.Sdk">
  <!--
    An SDK-style project, so the .NET SDK builds the .NET Framework 4.8 patcher
    on Linux as well as Windows (see build.sh). The build passes VERSION,
    SERVER_NAME, FILE_NAME, FILELIST_URL and PATCHER_URL, baked in below.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>EQEmu_Patcher</RootNamespace>
    <AssemblyName>eqemupatcher</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- the form's images are serialized objects: off Windows they are built
         this way and read back by System.Resources.Extensions -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <Version>$(VERSION)</Version>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="EQEmu_Patcher.ServerName"><_Parameter1>$(SERVER_NAME)</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="EQEmu_Patcher.FileListUrl"><_Parameter1>$(FILELIST_URL)</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="EQEmu_Patcher.PatcherUrl"><_Parameter1>$(PATCHER_URL)</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="EQEmu_Patcher.FileName"><_Parameter1>$(FILE_NAME)</_Parameter1></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="5.3.0" />
    <PackageReference Include="WindowsAPICodePack-Core" Version="1.1.2" />
    <PackageReference Include="WindowsAPICodePack-Shell" Version="1.1.1" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <!-- packs the libraries into the one exe players download -->
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
